# Copy to .env and fill in. The real .env is gitignored and never committed.
#
# ONLY the publishable key belongs in anything the app bundle can reach.
# The service-role / secret key must NEVER appear here, in EAS secrets exposed
# to the bundle, or anywhere else a React Native bundle can be unpacked to find
# it. Anything in a bundle is extractable — FC-1 test 11 exists to make that
# concrete, and apps/mobile/lib/env.ts throws at startup if a secret key is
# pasted into the publishable slot.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Origin of the apps/web compliance site — privacy, terms, and the
# account-deletion request route Google Play requires (ADR-0014). OPTIONAL and
# intentionally without a default: the site is not deployed and no domain is
# chosen, so Settings shows the paths as text until this is set, rather than
# shipping a guessed link that goes nowhere.
EXPO_PUBLIC_WEB_URL=

# apps/web (Next.js). Same project, different prefix: each build system only
# inlines its own, so the values are duplicated by necessity, not by choice.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Sentry — the DSN is public by design; the auth token is build-time only and
# does not belong in this file.
EXPO_PUBLIC_SENTRY_DSN=
