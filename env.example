# Copy to .env and fill in. The real .env is gitignored and never committed.
#
# ONLY the publishable (anon) key belongs in anything the app bundle can reach.
# The service-role key must NEVER appear here, in EAS secrets exposed to the
# bundle, or anywhere else a React Native bundle can be unpacked to find it.
# Anything in a bundle is extractable — FC-1 test 11 exists to make that concrete.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Sentry — DSN is public by design; the auth token is build-time only.
EXPO_PUBLIC_SENTRY_DSN=
