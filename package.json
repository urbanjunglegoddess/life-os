{
  "name": "life-os",
  "private": true,
  "description": "Multi-tenant, mobile-first personal life OS. See docs/BUILD-SPEC.md.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.19.4"
  },
  "scripts": {
    "check:tokens": "./scripts/check-tokens.sh",
    "mobile": "npm run start --workspace apps/mobile",
    "test": "node --test \"apps/**/*.test.ts\" \"packages/**/*.test.ts\"",
    "test:rls": "./scripts/test-rls.sh",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.tests.json"
  }
}
