{
  "name": "life-os",
  "private": true,
  "description": "Multi-tenant, mobile-first personal life OS. See docs/BUILD-SPEC.md.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.19.4"
  },
  "scripts": {
    "mobile": "npm run start --workspace apps/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:rls": "./scripts/test-rls.sh",
    "check:tokens": "./scripts/check-tokens.sh"
  }
}
